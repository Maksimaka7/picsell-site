diff --git a/layouts/partials/head.html b/layouts/partials/head.html
index ec4cd09..b7f130e 100644
--- a/layouts/partials/head.html
+++ b/layouts/partials/head.html
@@ -31,7 +31,10 @@
 <meta property="og:title" content="{{ $title }}"/>
 <meta property="og:description" content="{{ $description }}"/>
 <meta property="og:image" content="{{ $ogImage | absURL }}"/>
-<meta property="og:locale" content="{{ cond (eq .Language.Lang "uk") "uk_UA" "en_US" }}"/>
+{{/* Fourth site of the same root cause, after html lang and hreflang: .Language.Lang
+     is "uk" on every page but the homepage, so 31 English pages announced uk_UA to
+     Facebook, LinkedIn and every other scraper reading Open Graph. */}}
+<meta property="og:locale" content="{{ cond (strings.HasPrefix .RelPermalink "/en/") "en_US" "uk_UA" }}"/>
 <meta property="og:site_name" content="PICSELL"/>
 
 <!-- Twitter Card -->
diff --git a/layouts/partials/header.html b/layouts/partials/header.html
index 8388334..85a98a6 100644
--- a/layouts/partials/header.html
+++ b/layouts/partials/header.html
@@ -170,9 +170,9 @@ h1,h2,h3,h4{font-family:'Geologica',sans-serif;line-height:1.08;letter-spacing:-
   <div class="nav-r"><a href="tel:+380778809888" class="nav-link nav-phone" style="color:var(--t1);font-weight:600;font-size:13px;" aria-label="{{ if strings.HasPrefix .RelPermalink "/en/" }}PICSELL phone{{ else }}Телефон PICSELL{{ end }}">+380&nbsp;77&nbsp;880&nbsp;98&nbsp;88</a><div class="lang-switch">
   {{ if not (strings.HasPrefix .RelPermalink "/en/") }}
     <span class="lang-btn lang-active" title="Українська">🇺🇦 UA</span>
-    {{ if .Translations }}{{ range .Translations }}<a href="{{ .Permalink }}" class="lang-btn" hreflang="{{ .Language.Lang }}" title="English">🇺🇸 EN</a>{{ end }}{{ else }}<a href="/en/" class="lang-btn" hreflang="en" title="English">🇺🇸 EN</a>{{ end }}
+    {{ if .Translations }}{{ range .Translations }}<a href="{{ .Permalink }}" class="lang-btn" hreflang="en" title="English">🇺🇸 EN</a>{{ end }}{{ else }}<a href="/en/" class="lang-btn" hreflang="en" title="English">🇺🇸 EN</a>{{ end }}
   {{ else }}
-    {{ if .Translations }}{{ range .Translations }}<a href="{{ .Permalink }}" class="lang-btn" hreflang="{{ .Language.Lang }}" title="Ukrainian">🇺🇦 UA</a>{{ end }}{{ else }}<a href="/" class="lang-btn" hreflang="uk" title="Ukrainian">🇺🇦 UA</a>{{ end }}
+    {{ if .Translations }}{{ range .Translations }}<a href="{{ .Permalink }}" class="lang-btn" hreflang="uk" title="Ukrainian">🇺🇦 UA</a>{{ end }}{{ else }}<a href="/" class="lang-btn" hreflang="uk" title="Ukrainian">🇺🇦 UA</a>{{ end }}
     <span class="lang-btn lang-active" title="English">🇺🇸 EN</span>
   {{ end }}
 </div><a href="{{ "/demo/" | relLangURL }}" class="btn btn-p btn-sm">{{ if strings.HasPrefix .RelPermalink "/en/" }}Book Demo{{ else }}Замовити демо{{ end }}</a><button class="hamburger" id="hamburger" aria-label="{{ if strings.HasPrefix .RelPermalink "/en/" }}Menu{{ else }}Меню{{ end }}"><span></span><span></span><span></span></button></div>
